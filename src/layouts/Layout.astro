---
import "@fontsource-variable/inter";
import interLatinWoff2 from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import "../styles/global.css";
import { getLangFromUrl } from "../i18n/utils";
import { BASE_URL } from "../utils/constants";
import SEO from "../components/SEO.astro";

const { title, description, blockCanonical = false } = Astro.props;

const lang = getLangFromUrl(Astro.url);
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
	<head>
		<link rel="preload" href={interLatinWoff2} as="font" type="font/woff2" crossorigin />
		<SEO {title} {description} {blockCanonical} />
		<script is:inline>
			document.documentElement.classList.add("js");
		</script>
	</head>
	<body>
		<slot />
		<script src={`${BASE_URL}/taos.min.js`} is:inline defer></script>
	</body>
</html>

<style is:global>
	:root {
	}
	html {
		background: #040c0d;
		color: #b0c7cb;
		font-size: 16px;
	}
</style>
