---
import "@fontsource-variable/inter";
import interLatinWoff2 from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import "../styles/global.css";
import { getLangFromUrl } from "../i18n/utils";
import { BASE_URL } from "../utils/constants";
import SEO from "../components/SEO.astro";

const { title, description, blockCanonical = false } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const umamiWebsiteId = import.meta.env.UMAMI_WEBSITE_ID?.trim();
const analyticsEnabled = import.meta.env.PROD && import.meta.env.BASE_URL.replace(/\/+$/, "") === "/portfolio" && umamiWebsiteId;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
	<head>
		<link rel="preload" href={interLatinWoff2} as="font" type="font/woff2" crossorigin />
		<SEO {title} {description} {blockCanonical} />
		{analyticsEnabled && (
			<script is:inline define:vars={{ umamiWebsiteId }}>
				if (window.location.hostname === "matias-mg.github.io") {
					try {
						if (!localStorage.getItem("umami.disabled")) {
							const tracker = document.createElement("script");
							tracker.src = "https://cloud.umami.is/script.js";
							tracker.defer = true;
							tracker.dataset.websiteId = umamiWebsiteId;
							tracker.dataset.domains = "matias-mg.github.io";
							tracker.dataset.excludeSearch = "true";
							tracker.dataset.excludeHash = "true";
							tracker.dataset.doNotTrack = "true";
							document.head.appendChild(tracker);
						}
					} catch {
						// Do not load analytics if browser storage is unavailable.
					}
				}
			</script>
		)}
		<script is:inline>
			document.documentElement.classList.add("js");
		</script>
	</head>
	<body>
		<slot />
		<script src={`${BASE_URL}/taos.min.js`} is:inline defer></script>
	</body>
</html>

<style is:global>
	:root {
	}
	html {
		background: #040c0d;
		color: #b0c7cb;
		font-size: 16px;
	}
</style>
