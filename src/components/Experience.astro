---
import SectionTitle from "./SectionTitle.astro";
import KanduiLightThemeImage from "../images/kandui-light.webp";
import KanduiDarkThemeImage from "../images/kandui-dark.webp";
import RGCorpLightThemeImage from "../images/rg-corp-light.webp";
import RGCorpDarkThemeImage from "../images/rg-corp-dark.webp";
import FloQastImage from "../images/floqast.webp";
import DoubleImageExperienceContainer from "./DoubleImageExperienceContainer.astro";
import SingleImageJobExperienceContainer from "./SingleImageJobExperienceContainer.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section
    id="experience"
    class="relative max-w-7xl mx-auto mt-28 scroll-mt-8 md:mt-44"
>
    <SectionTitle
        prefix={t("experience.prefix")}
        title={t("experience.title")}
        classStyles="mb-6"
    />
    <div class="flex flex-col gap-16 md:gap-32">
        <SingleImageJobExperienceContainer
            jobTitle={t("experience.floqast-job-title")}
            company="FloQast (via FullStack Labs)"
            from={new Date(Date.UTC(2024, 10, 1))}
            to={new Date(Date.UTC(2026, 0, 1))}
            achievements={t("experience.floqast-job-achievements")}
            techList={[
                "React",
                "TypeScript",
                "Microfrontends",
                "Nx",
                "Storybook",
                "Jest",
                "Cypress",
                "Cursor",
                "Claude Code",
            ]}
            img={FloQastImage}
            imgSrc="floqast.webp"
            imgLoading="lazy"
            imgAlt="Matias Medina FloQast frontend engineering work screenshot"
        />
        <DoubleImageExperienceContainer
            right={false}
            jobTitle={t("experience.kandui-job-title")}
            company="Kandui.cl"
            from={new Date(Date.UTC(2022, 7, 1))}
            to={new Date(Date.UTC(2023, 8, 1))}
            achievements={t("experience.kandui-job-achievements")}
            techList={[
                "Next.js",
                "React",
                "TypeScript",
                "Redux",
                "Git",
                "HTML5",
                "CSS3",
                "Figma",
                "styled-components",
                "Django",
            ]}
            leftImage={KanduiLightThemeImage}
            rightImage={KanduiDarkThemeImage}
            leftImageSrc="kandui-dark.webp"
            rightImageSrc="kandui-light.webp"
            loading="lazy"
            classStyles=""
            leftImageAlt="Matias Medina Kandui.cl dark theme main trading view"
            rightImageAlt="Matias Medina Kandui.cl light theme main trading view"
        />
        <DoubleImageExperienceContainer
            jobTitle={t("experience.rg-corp-job-title")}
            company="Kandui.cl"
            from={new Date(Date.UTC(2020, 0))}
            to={new Date(Date.UTC(2022, 6))}
            achievements={t("experience.rg-corp-job-achievements")}
            techList={[
                "React",
                "TypeScript",
                "Redux",
                "Git",
                "Figma",
                "HTML5",
                "CSS3",
                "styled-components",
            ]}
            leftImage={RGCorpDarkThemeImage}
            rightImage={RGCorpLightThemeImage}
            leftImageSrc="rg-corp-dark.webp"
            rightImageSrc="rg-corp-light.webp"
            loading="lazy"
            classStyles=""
            leftImageAlt="Matias Medina Kandui.cl dark theme KYC form view"
            rightImageAlt="Matias Medina Kandui.cl light theme KYC form view"
        />
    </div>
    <div
        class="absolute -z-10 top-[15%] left-[10%] mx-auto size-[600px] filter blur-[110px] rounded-full animate-blob opacity-20 bg-blue-600"
    >
    </div>
</section>
